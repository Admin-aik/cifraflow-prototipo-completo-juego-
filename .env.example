# CifraFlow Prototype — Environment Configuration
#
# The app is frontend-only: it ALWAYS talks to the CifraFlow NestJS backend,
# never to Firebase directly.

# Base URL of the CifraFlow NestJS backend API (global prefix is /api).
# Local backend default port is 3153 (see cifraflow-backend/.env → PORT=3153).
VITE_API_URL="http://localhost:3153/api"

# Registered gameId (UUID) in the CifraFlow catalog for score transmission.
# Points are sent to POST /api/play/sync-results; the backend requires a valid
# registered gameId. Leave empty to disable score sending until it's registered.
VITE_GAME_ID=""

# Google OAuth Client ID (web) for Sign-In With Google (Google Identity Services).
# The frontend obtains a Google ID token and the backend verifies it.
# Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=""

# Content ID (UUID) of this game in the gaming-core catalog, used by the
# explicit score-transmission flow (POST /api/contents/:id/transmitir-puntos).
# Falls back to VITE_GAME_ID when empty. Leave empty to disable transmission.
VITE_CONTENT_ID=""